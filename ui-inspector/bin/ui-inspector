#!/bin/sh
set -eu
PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
if [ -z "${JAVA_HOME:-}" ]; then
  if [ -x "$PROJECT_ROOT/vendor/android/prebuilts/studio/jdk/jbr25/mac-arm64/Contents/Home/bin/java" ]; then
    JAVA_HOME="$PROJECT_ROOT/vendor/android/prebuilts/studio/jdk/jbr25/mac-arm64/Contents/Home"
  else
    JAVA_HOME="$(/usr/libexec/java_home -v '25+')"
  fi
fi
if [ -z "${ANDROID_HOME:-}" ]; then
  if [ -d "$PROJECT_ROOT/vendor/android/prebuilts/studio/sdk/darwin" ]; then
    ANDROID_HOME="$PROJECT_ROOT/vendor/android/prebuilts/studio/sdk/darwin"
  else
    ANDROID_HOME="${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}"
  fi
fi
export JAVA_HOME ANDROID_HOME
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$ANDROID_HOME/platform-tools:$JAVA_HOME/bin:$PATH"
JAVA="$JAVA_HOME/bin/java"
if [ ! -f "$PROJECT_ROOT/lib/ui-inspector.jar" ]; then
  "$PROJECT_ROOT/build.sh"
fi
exec "$JAVA" -jar "$PROJECT_ROOT/lib/ui-inspector.jar" "$@"
